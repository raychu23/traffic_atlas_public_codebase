{
  "printWidth": 100,
  "proseWrap": "always",
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "backend/**/*.js",
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": "scripts/**/*.js",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
