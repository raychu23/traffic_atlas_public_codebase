NODE_ENV=production
PORT=5001
AWS_REGION=us-east-1

# Durable EBS-backed storage outside the Git checkout. This contains source
# videos, job JSON, logs, trajectories, zones, counts, and generated artifacts.
TRAFFIC_VIDEO_DATA_ROOT=/var/lib/traffic-atlas/video
MAX_VIDEO_UPLOAD_BYTES=10737418240

# Start the GPU worker only while tracking or recounting is active.
TRAFFIC_PROCESSOR_MODE=ec2-on-demand-ssh
TRAFFIC_EC2_INSTANCE_ID=i-09d7366988c2ec368
TRAFFIC_EC2_SSH_USER=ubuntu
TRAFFIC_EC2_IDLE_SECONDS=300
TRAFFIC_EC2_START_TIMEOUT_SECONDS=600
TRAFFIC_EC2_POLL_MS=5000

# Install this key on the API host with traffic-atlas:traffic-atlas ownership
# and mode 0400. Do not commit the private key.
TRAFFIC_DEEPSTREAM_SSH_KEY=/etc/traffic-atlas/gpu-worker.pem
TRAFFIC_DEEPSTREAM_ROOT=/srv/traffic-video
TRAFFIC_DEEPSTREAM_IMAGE=traffic-video:ds8-atlas-20260722
TRAFFIC_DEEPSTREAM_MOUNT_APP=true
TRAFFIC_REMOTE_TRACKER=yolo-traffic
TRAFFIC_YOLO_REMOTE_IMAGE=traffic-yolo:cam5-reference

# Add the deployed Amplify origin and configure the existing Cognito, S3, and
# OpenAI backend secrets in /etc/traffic-atlas/api.env.
CORS_ALLOWED_ORIGINS=https://your-amplify-domain.example
