PORT=5001

# Optional comma-separated extra CORS origins (in addition to defaults in backend/index.js)
# CORS_ALLOWED_ORIGINS=https://my-preview.example.com

# ─── AWS Cognito (User Authentication) ────────────────────────────────────────
COGNITO_USER_POOL_ID=your-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=us-east-1
COGNITO_ACCESS_KEY_ID=your-cognito-key-id
COGNITO_SECRET_ACCESS_KEY=your-cognito-secret-key

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Optional bootstrap token for initial admin assignment via API
ADMIN_BOOTSTRAP_TOKEN=your-bootstrap-token
ADMIN_EMAILS=admin@example.com

# ─── AWS/S3 Storage Configuration ──────────────────────────────────────────────
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-s3-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET=your-bucket-name

# Optional key prefix inside bucket
S3_PREFIX=traffic-atlas/repo

# ─── AWS Step Functions (Vaidio processing pipeline) ─────────────────────────
STEP_FUNCTIONS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:<AWS_ACCOUNT_ID>:stateMachine:vaidio-trafficatlas-end-to-end-pipeline
# Optional: assume this role when API keys are in a different account than the state machine
STEP_FUNCTIONS_ASSUME_ROLE_ARN=arn:aws:iam::<AWS_ACCOUNT_ID>:role/VaidioTrafficAtlasApiTriggerRole
# true only after VaidioTrafficAtlasApiTriggerRole trust policy allows your IAM user
STEP_FUNCTIONS_USE_ASSUME_ROLE=false
# Optional: IAM user in pipeline account (<AWS_ACCOUNT_ID>) when S3 keys are in another account
# STEP_FUNCTIONS_AWS_ACCESS_KEY_ID=
# STEP_FUNCTIONS_AWS_SECRET_ACCESS_KEY=
# v1 = sample/ layout (live SFN). v2 = sample_dataset/ (only after SFN Batch jobs updated)
DATASET_S3_LAYOUT=v1

# CLIP embeddings on S3 (from Step Functions / Bedrock):
# {S3_PREFIX}/datasets/{dataset_id}/analysis/embeddings/clip/{video_id}/{video_id}_clip_embeddings.npy
# Optional local/bundled demo (testing branch / Amplify preview only):
# ALLOW_EMBEDDINGS_DEMO=true
# REACT_APP_USE_PIPELINE_DEMO=true
# Production uses live Step Functions + S3 outputs only (both flags unset or false).
