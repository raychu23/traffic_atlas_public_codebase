PORT=5001

# Optional comma-separated extra CORS origins (in addition to defaults in backend/index.js)
# CORS_ALLOWED_ORIGINS=https://my-preview.example.com

# ─── AWS Cognito (User Authentication) ────────────────────────────────────────
COGNITO_USER_POOL_ID=your-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=us-east-1
COGNITO_ACCESS_KEY_ID=your-cognito-key-id
COGNITO_SECRET_ACCESS_KEY=your-cognito-secret-key

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Optional bootstrap token for initial admin assignment via API
ADMIN_BOOTSTRAP_TOKEN=your-bootstrap-token
ADMIN_EMAILS=admin@example.com

# Local development only. Leave false in shared and deployed environments.
DEV_AUTH_ENABLED=false

# Backend-only OpenAI key for pre-processing traffic-scene validation.
# Never expose this as a REACT_APP_* variable or send it to the browser.
OPENAI_API_KEY=your-openai-api-key
OPENAI_TRAFFIC_SCENE_MODEL=gpt-4o
OPENAI_TRAFFIC_SCENE_TIMEOUT_MS=30000
MAX_VIDEO_UPLOAD_BYTES=10737418240
# On a deployed API EC2 host, set one persistent EBS-backed root outside the
# Git checkout. It stores accepted sources, job state, and generated artifacts.
# TRAFFIC_VIDEO_DATA_ROOT=/var/lib/traffic-atlas/video
# Optional per-directory overrides:
# TRAFFIC_VIDEO_JOBS_ROOT=/var/lib/traffic-atlas/video/jobs
# TRAFFIC_VIDEO_SOURCES_ROOT=/var/lib/traffic-atlas/video/sources
# TRAFFIC_VIDEO_STAGING_ROOT=/var/lib/traffic-atlas/video/staging
# Optional when Node cannot find ffmpeg/ffprobe on PATH.
# macOS Homebrew examples:
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Video processing defaults to the local development worker. Production can use
# deepstream-ssh after the worker host and key are provisioned.
TRAFFIC_PROCESSOR_MODE=local-yolo
# TRAFFIC_DEEPSTREAM_HOST=user@gpu-worker.example.com
# TRAFFIC_DEEPSTREAM_SSH_KEY=/absolute/backend-only/path/to/worker-key.pem
# TRAFFIC_DEEPSTREAM_ROOT=/srv/traffic-video
# TRAFFIC_DEEPSTREAM_IMAGE=traffic-video:ds8
# TRAFFIC_DEEPSTREAM_MOUNT_APP=false
# TRAFFIC_REMOTE_TRACKER=yolo-traffic
# TRAFFIC_YOLO_REMOTE_IMAGE=traffic-yolo:cam5-reference
# Optional smoke-test cap; omit in production to process the full upload.
# TRAFFIC_DEEPSTREAM_MAX_FRAMES=300

# EC2-only on-demand mode for installations that can manage the existing EC2
# instance but cannot provision S3/SQS. The backend serializes GPU operations,
# discovers the hostname after each start, and stops EC2 after the idle window.
# TRAFFIC_PROCESSOR_MODE=ec2-on-demand-ssh
# TRAFFIC_EC2_INSTANCE_ID=i-0123456789abcdef0
# TRAFFIC_EC2_SSH_USER=ubuntu
# TRAFFIC_EC2_IDLE_SECONDS=300
# TRAFFIC_EC2_START_TIMEOUT_SECONDS=600
# TRAFFIC_EC2_POLL_MS=5000
# Optional: keep each direct EC2 job in an S3 folder as well. This does not
# require Lambda and does not emit a wake-up manifest.
# TRAFFIC_VIDEO_BUCKET=traffic-atlas-db
# TRAFFIC_VIDEO_S3_PREFIX=traffic-video-jobs

# Production on-demand GPU worker. The backend stores inputs and outputs in S3,
# records durable status in DynamoDB, and sends tracking/recount work to SQS.
# A scheduled Lambda starts the stopped GPU EC2 instance when the queue is non-empty.
# TRAFFIC_PROCESSOR_MODE=sqs-ec2
# TRAFFIC_VIDEO_BUCKET=traffic-atlas-video-artifacts
# Minimal on-demand alternative: S3 manifest event -> Lambda -> the one GPU EC2.
# TRAFFIC_PROCESSOR_MODE=s3-lambda-ec2
# TRAFFIC_VIDEO_BUCKET=traffic-atlas-db
# TRAFFIC_VIDEO_S3_PREFIX=traffic-video-jobs
# TRAFFIC_VIDEO_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/traffic-atlas-video-jobs-production.fifo
# TRAFFIC_VIDEO_JOBS_TABLE=traffic-atlas-video-jobs-production
# TRAFFIC_VIDEO_S3_PREFIX=traffic-video-jobs
# TRAFFIC_VIDEO_JOB_TTL_DAYS=30

# Local-YOLO development worker. Defaults to the sibling ../traffic-tool
# directory and its .venv when present.
# TRAFFIC_PROCESSOR_ROOT=/absolute/path/to/traffic-tool
# TRAFFIC_PROCESSOR_PYTHON=/absolute/path/to/python
TRAFFIC_YOLO_MODEL=yolo11n.pt
TRAFFIC_YOLO_TRACKER=bytetrack.yaml
TRAFFIC_YOLO_DEVICE=auto
TRAFFIC_COUNT_BIN_SECONDS=900
# Optional development cap; omit to process the full uploaded video.
# TRAFFIC_YOLO_MAX_FRAMES=300

# ─── AWS/S3 Storage Configuration ──────────────────────────────────────────────
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-s3-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET=your-bucket-name

# Optional key prefix inside bucket
S3_PREFIX=traffic-atlas/repo

# ─── AWS Step Functions (Vaidio processing pipeline) ─────────────────────────
STEP_FUNCTIONS_STATE_MACHINE_ARN=arn:aws:states:us-east-1:<AWS_ACCOUNT_ID>:stateMachine:vaidio-trafficatlas-end-to-end-pipeline
# Optional: assume this role when API keys are in a different account than the state machine
STEP_FUNCTIONS_ASSUME_ROLE_ARN=arn:aws:iam::<AWS_ACCOUNT_ID>:role/VaidioTrafficAtlasApiTriggerRole
# true only after VaidioTrafficAtlasApiTriggerRole trust policy allows your IAM user
STEP_FUNCTIONS_USE_ASSUME_ROLE=false
# Optional: IAM user in pipeline account (<AWS_ACCOUNT_ID>) when S3 keys are in another account
# STEP_FUNCTIONS_AWS_ACCESS_KEY_ID=
# STEP_FUNCTIONS_AWS_SECRET_ACCESS_KEY=
# v1 = sample/ layout (live SFN). v2 = sample_dataset/ (only after SFN Batch jobs updated)
DATASET_S3_LAYOUT=v1

# CLIP embeddings on S3 (from Step Functions / Bedrock):
# {S3_PREFIX}/datasets/{dataset_id}/analysis/embeddings/clip/{video_id}/{video_id}_clip_embeddings.npy
# Optional local/bundled demo (testing branch / Amplify preview only):
# ALLOW_EMBEDDINGS_DEMO=true
# REACT_APP_USE_PIPELINE_DEMO=true
# Production uses live Step Functions + S3 outputs only (both flags unset or false).
