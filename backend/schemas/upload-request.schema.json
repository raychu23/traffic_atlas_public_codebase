{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-atlas.local/schemas/upload-request.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "uploaded_by",
    "title",
    "description",
    "category",
    "owner_name_or_org",
    "source",
    "funded_by",
    "license",
    "access_level",
    "contains_sensitive_data",
    "contact_email",
    "terms_and_conditions_accept",
    "rights_confirmation_accept",
    "privacy_compliance_accept"
  ],
  "properties": {
    "uploaded_by": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 5, "maxLength": 150 },
    "description": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "category": {
      "type": "string",
      "enum": ["Dataset", "Report", "Image", "Model", "Other"]
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "keywords": {
      "type": "array",
      "maxItems": 15,
      "items": { "type": "string", "minLength": 2, "maxLength": 30 },
      "uniqueItems": true
    },
    "owner_name_or_org": { "type": "string", "minLength": 2, "maxLength": 120 },
    "source": { "type": "string", "minLength": 3, "maxLength": 200 },
    "uploader_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "uploader_org": { "type": "string", "minLength": 2, "maxLength": 120 },
    "date_created": { "type": "string", "format": "date" },
    "collection_period_start": { "type": "string", "format": "date" },
    "collection_period_end": { "type": "string", "format": "date" },
    "funded_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2, "maxLength": 200 }
    },
    "grant_or_project_id": { "type": "string", "minLength": 2, "maxLength": 80 },
    "partner_institutions": {
      "type": "array",
      "items": { "type": "string", "minLength": 2, "maxLength": 120 },
      "uniqueItems": true
    },
    "related_project_url": { "type": "string", "format": "uri" },
    "license": {
      "type": "string",
      "enum": ["CC BY 4.0", "CC BY-NC 4.0", "MIT", "Internal", "Restricted", "Other"]
    },
    "access_level": {
      "type": "string",
      "enum": ["Public", "Private", "Restricted"]
    },
    "allowed_users_or_teams": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "uniqueItems": true
    },
    "embargo_until": { "type": "string", "format": "date" },
    "contains_sensitive_data": { "type": "boolean" },
    "sensitive_data_type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["PII", "Health", "Financial", "Other"]
      },
      "uniqueItems": true
    },
    "ethics_irb_reference": { "type": "string", "minLength": 2, "maxLength": 120 },
    "contact_email": { "type": "string", "format": "email", "maxLength": 254 },
    "terms_and_conditions_accept": { "type": "boolean", "const": true },
    "rights_confirmation_accept": { "type": "boolean", "const": true },
    "privacy_compliance_accept": { "type": "boolean", "const": true },
    "terms_version_accepted": { "type": "string", "minLength": 1, "maxLength": 64 },
    "change_notes": { "type": "string", "minLength": 3, "maxLength": 1000 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "access_level": { "const": "Restricted" } },
        "required": ["access_level"]
      },
      "then": {
        "required": ["allowed_users_or_teams"],
        "properties": {
          "allowed_users_or_teams": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "contains_sensitive_data": { "const": true } },
        "required": ["contains_sensitive_data"]
      },
      "then": {
        "required": ["sensitive_data_type"],
        "properties": {
          "sensitive_data_type": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sensitive_data_type": {
            "contains": { "const": "Health" }
          }
        },
        "required": ["sensitive_data_type"]
      },
      "then": {
        "required": ["ethics_irb_reference"]
      }
    }
  ]
}
