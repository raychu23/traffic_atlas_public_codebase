# Dockerfile for frame extraction Batch job
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-extraction.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-extraction.txt

# Copy the job script
COPY frame-extraction.py /app/

WORKDIR /app

# Set entry point
ENTRYPOINT ["python", "frame-extraction.py"]
