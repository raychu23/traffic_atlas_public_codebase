{
  "name": "traffic-atlas",
  "version": "1.0.0",
  "description": "Traffic Atlas - Open-access cloud-based traffic video repository",
  "main": "backend/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon backend/index.js",
    "client": "cd frontend && npm start",
    "install-all": "npm install && cd frontend && npm install",
    "seed": "node backend/seed.js",
    "set-admin": "node backend/scripts/set-admin.js",
    "set-password": "node backend/scripts/set-password.js",
    "sync-s3": "node backend/scripts/sync-data-to-s3.js",
    "init-s3": "node backend/scripts/init-s3-structure.js",
    "discover-pipeline": "node backend/scripts/discover-pipeline-arn.js",
    "start-pipeline": "node backend/scripts/start-pipeline.js"
  },
  "keywords": [
    "traffic",
    "video",
    "repository"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1015.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-ses": "^3.1015.0",
    "@aws-sdk/client-sfn": "^3.1049.0",
    "@aws-sdk/client-sts": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "ml-pca": "^4.1.1",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
